# Copy to /data/veda/config/veda.env and chmod 0640 root:veda — that is the
# path veda-server.service loads via EnvironmentFile= (change both if you
# deploy elsewhere). veda-server.service is the only unit that reads it;
# there is no separate migration unit, schema bootstrap runs inline at
# server start.
# Anything in here overrides the corresponding values from config.toml.

VEDA_METRICS_TOKEN=
VEDA_MYSQL_URL=mysql://veda:veda-dev@127.0.0.1:3306/veda
VEDA_MILVUS_URL=http://127.0.0.1:19530
VEDA_EMBEDDING_API_KEY=
VEDA_LLM_API_KEY=

RUST_LOG=info,veda=debug
